{
  "name": "kejarsnbt-topscore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const src=p.join(process.cwd(),'node_modules/pdfjs-dist/build/pdf.worker.min.mjs');if(fs.existsSync(src)){fs.mkdirSync(p.join(process.cwd(),'public'),{recursive:true});fs.copyFileSync(src,p.join(process.cwd(),'public/pdf.worker.min.mjs'));}\""
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.49.4",
    "acorn": "^8.14.1",
    "drizzle-orm": "^0.43.1",
    "fraction.js": "^5.2.1",
    "katex": "^0.16.21",
    "mathjs": "^14.2.1",
    "next": "^15.3.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.14.1",
    "quickjs-emscripten": "^0.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.33.5",
    "ts-fsrs": "^4.7.0",
    "zod": "^3.24.2"
  },
