# PostgreSQL + pgvector (Supabase Free Tier or Local Docker)
# Leave empty during local offline exploration to use automatic local-state.json persistence.
DATABASE_URL=
DIRECT_URL=

# Supabase Private Object Storage (Optional locally; falls back to .data/vault-files)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brain-vault

# 9router OpenAI-Compatible AI Gateway
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=sk-9router-local-dev
NINE_ROUTER_TIMEOUT_MS=20000
NINE_ROUTER_MODEL_EMBED=snbt-embed
NINE_ROUTER_MODEL_FAST=snbt-fast
NINE_ROUTER_MODEL_VISION=snbt-vision
NINE_ROUTER_MODEL_REASON=snbt-reason
NINE_ROUTER_MODEL_CODE_MATH=snbt-code-math

# Deterministic Math Verification Sandbox
MATH_SANDBOX_DRIVER=quickjs_wasm
SYMPY_SANDBOX_URL=
SANDBOX_HMAC_SECRET=replace-with-32-byte-random-hex

# Portable Session Auth Cookie Secret
SESSION_SECRET=replace-with-64-char-random-hex-secret
